rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Products
    match /products/{docId} {
      allow read: if true;                  // public read
      allow write: if request.auth != null; // only authenticated can create/update/delete
    }

    // Contacts
    match /contacts/{docId} {
      allow create: if true;                // allow public form submissions
      allow read, update, delete: if request.auth != null; // only admins (signed in) can view/manage
    }

    // Testimonials
    match /testimonials/{docId} {
      allow read: if true;                  // public read (displayed on homepage)
      allow create, update, delete: if request.auth != null; // only authenticated can add/edit/delete
    }
  }
}
